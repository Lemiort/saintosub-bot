TELEGRAM_BOT_TOKEN=your_bot_token

# Connect to an already-running OpenAI-compatible server. No model is launched.
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b-qat
LLM_API_KEY=

# Only enable types supported by BOTH the server API and the selected model.
# Options: image,audio,video,file. UTF-8 text documents work without a flag.
LLM_MEDIA=image
LLM_TIMEOUT_SECS=180
LLM_MAX_ATTACHMENT_MB=10
LLM_MAX_TOKENS=2048
LLM_HISTORY_TURNS=4
# LLM_SYSTEM_PROMPT="You are a helpful assistant. Reply in the user's language."
